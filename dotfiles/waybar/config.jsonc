{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": ["dwl/tags", "dwl/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "cpu", "memory", "tray"],
  "dwl/tags": { "num-tags": 5 },
  "dwl/window": { "format": "{title}", "max-length": 50 },
  "clock": { "format": "{:%a %d %b  %H:%M}" },
  "cpu": { "format": " {usage}%" },
  "memory": { "format": " {percentage}%" },
  "network": { "format-wifi": " {signalStrength}%", "format-ethernet": "󰈀", "format-disconnected": "󰖪" },
  "pulseaudio": { "format": "{icon} {volume}%", "format-muted": "󰝟", "format-icons": { "default": ["", "", ""] }, "on-click": "pavucontrol" },
  "tray": { "spacing": 8 }
}
